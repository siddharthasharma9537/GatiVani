# HTTP
PORT=8788
NODE_ENV=production
PUBLIC_ORIGIN=https://gativani.sohum.cloud

# Sarvam AI — OCR (Vision), TTS, STT.
# Get your API key from https://console.sarvam.ai
SARVAM_API_KEY=your-sarvam-api-key-here

# Supabase — extracted text storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Subscription tier page caps
TIER_FREE_MAX_PAGES=5
TIER_STANDARD_MAX_PAGES=50
TIER_PREMIUM_MAX_PAGES=500

# Dev only — accept X-Subscription-Tier / X-Subscription-Active from the client.
# Production should verify tier server-side (JWT, billing webhook) before trusting.
TRUST_CLIENT_TIER_HEADERS=false
